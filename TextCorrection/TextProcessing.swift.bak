import Cocoa

class TextProcessing {
    static func compareTexts(original: String, rewritten: String, customFont: NSFont) -> NSAttributedString {
        let attributedString = NSMutableAttributedString()
        
        let paragraphStyle = NSMutableParagraphStyle()
        paragraphStyle.lineSpacing = 8  // 增加行間距
        
        let baseAttributes: [NSAttributedString.Key: Any] = [
            .font: customFont,
            .foregroundColor: NSColor.white,
            .paragraphStyle: paragraphStyle,
            .kern: 1.5  // 增加字距
        ]
        
        let diff = diffStrings(original, rewritten)
        
        for change in diff {
            switch change {
            case .equal(let text):
                attributedString.append(NSAttributedString(string: text, attributes: baseAttributes))
            case .insert(let text):
                var attributes = baseAttributes
                attributes[.backgroundColor] = NSColor(red: 0.0, green: 0.5, blue: 0.0, alpha: 0.3)
                attributedString.append(NSAttributedString(string: text, attributes: attributes))
            case .delete(let text):
                var attributes = baseAttributes
                attributes[.strikethroughStyle] = NSUnderlineStyle.single.rawValue
                attributes[.strikethroughColor] = NSColor.red
                attributes[.backgroundColor] = NSColor(red: 0.5, green: 0.0, blue: 0.0, alpha: 0.3)
                attributedString.append(NSAttributedString(string: text, attributes: attributes))
            }
        }
        
        return attributedString
    }
    
    enum DiffChange {
        case equal(String)
        case insert(String)
        case delete(String)
    }
    
    // 改進的差異比較算法，使用字符級別比較，專為中文和標點符號優化
    static func diffStrings(_ old: String, _ new: String) -> [DiffChange] {
        // 如果處理空字串的情況
        if old.isEmpty && new.isEmpty {
            return []
        } else if old.isEmpty {
            return [.insert(new)]
        } else if new.isEmpty {
            return [.delete(old)]
        }
        
        // 將字符串轉換為字符數組，按字符比較
        let oldChars = Array(old)
        let newChars = Array(new)
        let m = oldChars.count
        let n = newChars.count
        
        // 構建最長公共子序列矩陣
        var dp = Array(repeating: Array(repeating: 0, count: n + 1), count: m + 1)
        
        // 填充LCS矩陣
        for i in 1...m {
            for j in 1...n {
                if oldChars[i-1] == newChars[j-1] {
                    dp[i][j] = dp[i-1][j-1] + 1
                } else {
                    dp[i][j] = max(dp[i-1][j], dp[i][j-1])
                }
            }
        }
        
        // 從矩陣回溯生成差異序列
        var diff = [DiffChange]()
        var i = m, j = n
        
        while i > 0 || j > 0 {
            if i > 0 && j > 0 && oldChars[i-1] == newChars[j-1] {
                // 字符相同，標記為相等
                diff.insert(.equal(String(oldChars[i-1])), at: 0)
                i -= 1
                j -= 1
            } else if j > 0 && (i == 0 || dp[i][j-1] >= dp[i-1][j]) {
                // 新文本中多出的字符，標記為插入
                diff.insert(.insert(String(newChars[j-1])), at: 0)
                j -= 1
            } else {
                // 舊文本中被移除的字符，標記為刪除
                diff.insert(.delete(String(oldChars[i-1])), at: 0)
                i -= 1
            }
        }
        
        // 合併相鄰的相同類型變化，提高顯示效果
        return combineAdjacentChanges(diff)
    }
    
    // 合併相鄰的相同類型變更，提高差異顯示的可讀性
    private static func combineAdjacentChanges(_ changes: [DiffChange]) -> [DiffChange] {
        guard !changes.isEmpty else { return [] }
        
        var result = [DiffChange]()
        var currentIndex = 0
        
        while currentIndex < changes.count {
            let current = changes[currentIndex]
            var combinedText = extractText(from: current)
            let changeType = getChangeType(of: current)
            
            var nextIndex = currentIndex + 1
            // 尋找並合併相鄰的相同類型變更
            while nextIndex < changes.count {
                let next = changes[nextIndex]
                if getChangeType(of: next) == changeType {
                    combinedText += extractText(from: next)
                    nextIndex += 1
                } else {
                    break
                }
            }
            
            // 根據類型創建合併後的變更
            switch changeType {
            case .equal:
                result.append(.equal(combinedText))
            case .insert:
                result.append(.insert(combinedText))
            case .delete:
                result.append(.delete(combinedText))
            }
            
            currentIndex = nextIndex
        }
        
        // 進一步優化：確保標點符號和其前面的文字一起顯示
        return optimizeForPunctuation(result)
    }
    
    // 獲取變更的類型
    private static func getChangeType(of change: DiffChange) -> DiffChangeType {
        switch change {
        case .equal: return .equal
        case .insert: return .insert
        case .delete: return .delete
        }
    }
    
    // 提取變更中的文字
    private static func extractText(from change: DiffChange) -> String {
        switch change {
        case .equal(let text): return text
        case .insert(let text): return text
        case .delete(let text): return text
        }
    }
    
    // 優化差異顯示，特別是標點符號和周圍字符的處理
    private static func optimizeForPunctuation(_ changes: [DiffChange]) -> [DiffChange] {
        guard changes.count > 1 else { return changes }
        
        var result = [DiffChange]()
        var i = 0
        
        while i < changes.count {
            let current = changes[i]
            var currentText = extractText(from: current)
            let currentType = getChangeType(of: current)
            
            // 檢查是否是單個標點符號
            if currentText.count == 1 && isPunctuation(currentText) && i + 1 < changes.count {
                let next = changes[i+1]
                let nextType = getChangeType(of: next)
                
                // 如果標點符號後面接相同類型的變更，將它們合併
                if currentType == nextType {
                    let combinedText = currentText + extractText(from: next)
                    switch currentType {
                    case .equal:
                        result.append(.equal(combinedText))
                    case .insert:
                        result.append(.insert(combinedText))
                    case .delete:
                        result.append(.delete(combinedText))
                    }
                    i += 2
                    continue
                }
            }
            
            // 一般情況
            result.append(current)
            i += 1
        }
        
        // 特殊處理：標點符號應該與前面的文字同類型
        return handlePunctuationWithPrecedingText(result)
    }
    
    // 檢查是否為標點符號
    private static func isPunctuation(_ str: String) -> Bool {
        guard str.count == 1, let char = str.first else { return false }
        return char.isPunctuation || char.isWhitespace
    }
    
    // 確保標點符號與前面的文字保持相同的樣式
    private static func handlePunctuationWithPrecedingText(_ changes: [DiffChange]) -> [DiffChange] {
        guard changes.count > 1 else { return changes }
        
        var result = [DiffChange]()
        var i = 0
        
        while i < changes.count {
            if i + 1 < changes.count {
                let current = changes[i]
                let next = changes[i+1]
                let currentText = extractText(from: current)
                let nextText = extractText(from: next)
                
                // 如果當前是文字，下一個是標點符號，且標點只有一個字符，則合併它們
                if !currentText.isEmpty && nextText.count == 1 && isPunctuation(nextText) {
                    let combinedText = currentText + nextText
                    switch getChangeType(of: current) {
                    case .equal:
                        result.append(.equal(combinedText))
                    case .insert:
                        result.append(.insert(combinedText))
                    case .delete:
                        result.append(.delete(combinedText))
                    }
                    i += 2
                    continue
                }
            }
            
            // 一般情況
            result.append(changes[i])
            i += 1
        }
        
        return result
    }
    
    // 變更類型枚舉，用於內部處理
    private enum DiffChangeType {
        case equal
        case insert
        case delete
    }
    
    // 變更類型枚舉
    enum ChangeType {
        case unchanged
        case added
        case deleted
        case modified
    }
    
    // 文本變更枚舉
    enum TextChange {
        case unchanged(text: String)
        case added(text: String)
        case deleted(text: String)
        case modified(original: String, rewritten: String)
    }
    
    // 文本部分變更枚舉
    enum TextPartChange {
        case unchanged(text: String)
        case added(text: String)
        case deleted(text: String)
    }
    
    // 預處理文本，確保比較的準確性
    static func processForComparison(text: String) -> [String] {
        let processedText = text.replacingOccurrences(of: "\r\n", with: "\n")
        let sentences = processedText.components(separatedBy: CharacterSet(charactersIn: "。.!?！？\n"))
            .map { $0.trimmingCharacters(in: .whitespacesAndNewlines) }
            .filter { !$0.isEmpty }
        return sentences
    }
    
    // 比較文本差異
    private static func analyzeChanges(original: String, rewritten: String) -> [TextChange] {
        var changes = [TextChange]()
        let originalSegments = processForComparison(text: original)
        let rewrittenSegments = processForComparison(text: rewritten)
        
        // 簡單比較算法，對於複雜的大型文本可能需要更高級的算法
        for (index, originalSegment) in originalSegments.enumerated() {
            if index < rewrittenSegments.count {
                let rewrittenSegment = rewrittenSegments[index]
                // 檢查句子之間的差異
                let changeType = getChangeType(of: originalSegment, compared: rewrittenSegment)
                
                switch changeType {
                case .unchanged:
                    changes.append(.unchanged(text: originalSegment))
                case .added:
                    changes.append(.added(text: rewrittenSegment))
                case .deleted:
                    changes.append(.deleted(text: originalSegment))
                case .modified:
                    changes.append(.modified(original: originalSegment, rewritten: rewrittenSegment))
                }
            } else {
                // 原始文本中多出的句子
                changes.append(.deleted(text: originalSegment))
            }
        }
        
        // 處理重寫文本中額外的句子
        if rewrittenSegments.count > originalSegments.count {
            for index in originalSegments.count..<rewrittenSegments.count {
                changes.append(.added(text: rewrittenSegments[index]))
            }
        }
        
        return changes
    }
    
    // 獲取變更類型
    private static func getChangeType(of original: String, compared rewritten: String) -> ChangeType {
        if original == rewritten {
            return .unchanged
        } else if original.isEmpty {
            return .added
        } else if rewritten.isEmpty {
            return .deleted
        } else {
            // 檢查相似度以確定是修改還是完全替換
            let similarity = calculateSimilarity(original, rewritten)
            if similarity > 0.5 { // 相似度閾值
                return .modified
            } else {
                return .deleted // 視為刪除原始文本並添加新文本
            }
        }
    }
    
    // 計算兩個字符串的相似度
    private static func calculateSimilarity(_ s1: String, _ s2: String) -> Double {
        guard !s1.isEmpty && !s2.isEmpty else { return 0.0 }
        
        let length1 = s1.count
        let length2 = s2.count
        
        // 計算Levenshtein距離
        var matrix = Array(repeating: Array(repeating: 0, count: length2 + 1), count: length1 + 1)
        
        for i in 0...length1 {
            matrix[i][0] = i
        }
        
        for j in 0...length2 {
            matrix[0][j] = j
        }
        
        for i in 1...length1 {
            for j in 1...length2 {
                let s1Index = s1.index(s1.startIndex, offsetBy: i - 1)
                let s2Index = s2.index(s2.startIndex, offsetBy: j - 1)
                
                let cost = s1[s1Index] == s2[s2Index] ? 0 : 1
                
                matrix[i][j] = min(
                    matrix[i-1][j] + 1,      // 刪除
                    matrix[i][j-1] + 1,      // 插入
                    matrix[i-1][j-1] + cost  // 替換
                )
            }
        }
        
        let distance = Double(matrix[length1][length2])
        let maxLength = Double(max(length1, length2))
        
        // 相似度 = 1 - 距離/最大長度
        return 1.0 - (distance / maxLength)
    }
    
    // 計算兩個字符串的相似度
    private static func analyzeChangesInParts(changes: [TextChange]) -> [TextPartChange] {
        var partChanges = [TextPartChange]()
        
        for change in changes {
            switch change {
            case .unchanged(let text):
                partChanges.append(.unchanged(text: text))
            case .added(let text):
                partChanges.append(.added(text: text))
            case .deleted(let text):
                partChanges.append(.deleted(text: text))
            case .modified(let original, let rewritten):
                // 逐字符比較以找出具體修改的部分
                let detailedChanges = compareCharacters(original: original, rewritten: rewritten)
                partChanges.append(contentsOf: detailedChanges)
            }
        }
        
        return partChanges
    }
    
    // 逐字符比較，找出具體修改的部分
    private static func compareCharacters(original: String, rewritten: String) -> [TextPartChange] {
        // 使用更高效的字符比較算法
        let originalChars = Array(original)
        let rewrittenChars = Array(rewritten)
        var i = 0, j = 0
        var partChanges = [TextPartChange]()
        
        while i < originalChars.count || j < rewrittenChars.count {
            if i < originalChars.count && j < rewrittenChars.count && originalChars[i] == rewrittenChars[j] {
                // 相同字符
                let currentText = String(originalChars[i])
                let currentType = ChangeType.unchanged
                
                // 尋找連續相同的字符
                var end = i + 1
                var jEnd = j + 1
                while end < originalChars.count && jEnd < rewrittenChars.count && originalChars[end] == rewrittenChars[jEnd] {
                    end += 1
                    jEnd += 1
                }
                
                let text = String(originalChars[i..<end])
                partChanges.append(.unchanged(text: text))
                i = end
                j = jEnd
            } else if j < rewrittenChars.count {
                // 添加的字符
                let start = j
                var end = j + 1
                while end < rewrittenChars.count && (i >= originalChars.count || rewrittenChars[end] != originalChars[i]) {
                    end += 1
                }
                
                let text = String(rewrittenChars[start..<end])
                partChanges.append(.added(text: text))
                j = end
            } else {
                // 刪除的字符
                let start = i
                var end = i + 1
                while end < originalChars.count {
                    end += 1
                }
                
                let text = String(originalChars[start..<end])
                partChanges.append(.deleted(text: text))
                i = end
            }
        }
        
        return partChanges
    }
}